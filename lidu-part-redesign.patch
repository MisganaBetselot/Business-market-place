@@ -0,0 +1,74 @@
+import { Link } from "react-router-dom";
+
+const points = [
+  { icon: "🤝", text: "Verified sellers and reviewed listings, so you're not guessing." },
+  { icon: "📍", text: "Businesses across Addis Ababa, from cafés to retail shops." },
+  { icon: "💬", text: "Message a seller directly once you've found the right fit." },
+];
+
+/**
+ * Shared shell for Login / Register / Reset password. Split screen instead
+ * of a lone centered card: form on the left (white, does the work), a
+ * sage panel on the right that actually says something about the
+ * marketplace instead of decorating for its own sake. Collapses to just
+ * the form on small screens.
+ */
+export default function AuthLayout({ eyebrow, title, subtitle, children }) {
+  return (
+    <div className="grid min-h-[calc(100vh-4rem)] grid-cols-1 lg:grid-cols-2">
+      {/* Form side */}
+      <div className="relative flex items-center justify-center overflow-hidden px-4 py-16 sm:px-8">
+        <div
+          aria-hidden="true"
+          className="animate-drift pointer-events-none absolute -left-24 -top-24 h-72 w-72 rounded-full bg-sage-100 opacity-60 blur-3xl"
+        />
+        <div className="relative w-full max-w-sm animate-fade-up">
+          <Link to="/" className="mb-8 inline-block font-display text-lg font-semibold text-brand-600">
+            Business Marketplace
+          </Link>
+          {eyebrow && (
+            <p className="mb-2 text-xs font-semibold uppercase tracking-wider text-brand-500">
+              {eyebrow}
+            </p>
+          )}
+          <h1 className="font-display text-3xl font-semibold text-ink">{title}</h1>
+          {subtitle && <p className="mt-2 text-sm text-ink-soft">{subtitle}</p>}
+
+          <div className="mt-8">{children}</div>
+        </div>
+      </div>
+
+      {/* Sage showcase side */}
+      <div className="relative hidden overflow-hidden bg-gradient-to-br from-brand-600 to-brand-700 lg:flex lg:flex-col lg:justify-center lg:px-14 lg:py-16">
+        <div
+          aria-hidden="true"
+          className="animate-drift pointer-events-none absolute -right-16 top-10 h-80 w-80 rounded-full bg-brand-400/30 blur-3xl"
+        />
+        <div
+          aria-hidden="true"
+          className="animate-drift pointer-events-none absolute bottom-0 left-0 h-64 w-64 rounded-full bg-sage-400/20 blur-3xl"
+          style={{ animationDelay: "3s" }}
+        />
+
+        <div className="relative">
+          <p className="font-display text-2xl font-medium leading-snug text-white sm:text-3xl">
+            Buy and sell <span className="font-display-italic">established</span> businesses,
+            not just ideas.
+          </p>
+
+          <div className="mt-10 flex flex-col gap-5">
+            {points.map((p, i) => (
+              <div
+                key={p.text}
+                className={`flex items-start gap-3 animate-fade-up stagger-${i + 1}`}
+              >
+                <span className="text-xl leading-none">{p.icon}</span>
+                <p className="text-sm text-white/85">{p.text}</p>
+              </div>
+            ))}
+          </div>
+        </div>
+      </div>
+    </div>
+  );
+}
